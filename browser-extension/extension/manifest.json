{
  "manifest_version": 3,
  "name": "Mauz",
  "description": "Lets Mauz read the page under your pointer when you ask it about that page.",
  "version": "0.1.0",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/mauz-128.png"
  },
  "minimum_chrome_version": "116"
}
