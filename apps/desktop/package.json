{
  "name": "@mauzai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "productName": "MauzAI",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "electron:install": "node scripts/ensure-electron-runtime.mjs",
    "stop:mac": "node scripts/stop-macos.mjs",
    "package:mac": "pnpm --filter @mauzai/shared build && pnpm --filter @mauzai/api build && node scripts/ensure-electron-runtime.mjs && electron-vite build && node scripts/package-macos.mjs",
    "install:mac": "node scripts/stop-macos.mjs && pnpm run package:mac && node scripts/launch-macos.mjs",
    "launch:mac": "node scripts/launch-macos.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mauzai/api": "workspace:*",
    "@mauzai/shared": "workspace:*",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.11.18",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
